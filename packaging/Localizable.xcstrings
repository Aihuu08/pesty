      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此片段没有可预览的文本。"
          }
        }
      }
    },
    "This setting removes %lld clips from history on this Mac now, and keeps pruning automatically. Pinboards are not affected, and there is no undo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设置会立即从这台 Mac 的历史中移除 %lld 个片段，之后也会自动清理。固定板不受影响，且无法撤销。"
          }
        }
      }
    },
