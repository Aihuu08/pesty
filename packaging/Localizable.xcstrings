    },
    "History and pinboards on disk": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史和固定板占用空间"
          }
        }
      }
    },
    "Hold the plain-text modifier while using Quick Paste to strip formatting — with the defaults, ⌘⇧1 pastes the first clip as plain text. The two roles can never share a modifier; picking one that is taken swaps them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用快速粘贴时按住“纯文本”修饰键即可去除格式——按默认设置，⌘⇧1 会以纯文本粘贴第一个片段。两项功能不能共用同一个修饰键，选择已被占用的修饰键时两者会互换。"
          }
        }
      }
    },
    "iCloud Drive Unavailable": {
      "localizations": {
        "zh-Hans": {
